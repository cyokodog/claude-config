{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NEW_INIT": "true"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(gh pr merge:*)"
    ]
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); dir=$(echo \"$input\" | jq -r '.workspace.current_dir' | sed \"s|$HOME|~|\" | xargs basename); printf \"\\033[2m%s in %s\\033[0m\" \"$model\" \"$dir\""
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": false,
  "advisorModel": "opus",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "autoCompactEnabled": false,
  "skipAutoPermissionPrompt": true
}
